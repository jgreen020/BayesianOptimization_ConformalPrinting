%% Figure: Final Sampling Pattern with Top and Isometric Images
close all; clear; clc;

% --- List of all trial filenames ---
trial_filenames = {
    '20250515_225518_Surf1b_M1_real'
};

% Folder where your .png images are stored (leave empty '' if in current folder)
image_folder = 'surface1'; 

addpath(genpath(fullfile(pwd)));

% --- Master Loop ---
for k = 1:numel(trial_filenames)
    current_trial = trial_filenames{k};
    
    % Check for .mat file existence
    full_path = current_trial;
    if ~contains(full_path, '.mat'), full_path = [full_path, '.mat']; end
    if ~exist(full_path, 'file'), fprintf('File not found: %s\n', full_path); continue; end
    
    load(full_path);
    fprintf('Processing: %s\n', current_trial);

    % --- 1. Parse filename for image strings (s1m1, s1m2, etc) ---
    % Extracts the digit after 'Surf' and 'M'
    s_idx = regexp(current_trial, 'Surf(\d)', 'tokens', 'once');
    m_idx = regexp(current_trial, 'M(\d)', 'tokens', 'once');
    
    img_prefix = lower(['s', s_idx{1}, 'm', m_idx{1}]); % e.g., 's1m1'
    top_view_file = fullfile(image_folder, [img_prefix, 'top.png']);
    iso_view_file = fullfile(image_folder, [img_prefix, 'iso.png']);

    % --- 2. Determine testpoint counts ---
    if method == 1 && contains(SurfB, "Surf1"),         testpoint_counts = [3, 4, 5, 6, 15];
    elseif method == 1 && contains(SurfB, "Surf2"),     testpoint_counts = [3, 8, 9, 10, 15];
    elseif method == 1 && contains(SurfB, "Surf3"),     testpoint_counts = [3, 11, 12, 13, 15]; 
    elseif (method == 2 || method == 3) && contains(SurfB, "Surf1"), testpoint_counts = [10, 14, 15, 16, 225];
    elseif (method == 2 || method == 3) && contains(SurfB, "Surf2"), testpoint_counts = [20, 40, 50, 60, 225];
    elseif (method == 2 || method == 3) && contains(SurfB, "Surf3"), testpoint_counts = [40, 60, 70, 80, 225];
    end
    num_points = testpoint_counts(end);

    % --- 3. Figure Configuration ---
    % Width = 7 inches (Standard full page width), Height = 2.2 inches
    fig = figure('Name', current_trial, 'Units', 'inches', 'Position', [0.5 0.5 7 2.2], 'Color', 'w');
    t = tiledlayout(1, 3, 'TileSpacing', 'loose', 'Padding', 'tight');
    
    % --- TILE 1: Red Sampling Plot ---
    ax1 = nexttile(t);
    hold(ax1, 'on');
    if method == 1
        grid_dim = num_points;
        [X_grid, Y_grid] = meshgrid(linspace(x_min, x_max, grid_dim), linspace(y_min, y_max, grid_dim));
        plot(ax1, X_grid(:), Y_grid(:), 'r.', 'MarkerSize', 8);
    else
        current_testpoints = testpoints(1:num_points, :);
        current_mask = mask(1:num_points);
        plot(ax1, current_testpoints(current_mask,1), current_testpoints(current_mask,2), 'r.', 'MarkerSize', 8);
    end
    axis(ax1, 'square'); xlim(ax1, [-30 30]); ylim(ax1, [-30 30]);
    set(ax1, 'XTick', -30:15:30, 'YTick', -30:15:30);
    xlabel(ax1, 'x [mm]'); ylabel(ax1, 'y [mm]');
    title(ax1, 'Sampling Pattern', 'FontSize', 10);
    grid(ax1, 'on');

    % --- TILE 2: Top View Image ---
    ax2 = nexttile(t);
    try
        img_top = imread(top_view_file);
        imshow(img_top, 'Parent', ax2);
        title(ax2, 'Top View (Physical)', 'FontSize', 10);
    catch
        text(0.5, 0.5, ['Missing: ' top_view_file], 'HorizontalAlignment', 'center');
        axis off;
    end

    % --- TILE 3: Isometric View Image ---
    ax3 = nexttile(t);
    try
        img_iso = imread(iso_view_file);
        imshow(img_iso, 'Parent', ax3);
        title(ax3, 'Isometric View', 'FontSize', 10);
    catch
        text(0.5, 0.5, ['Missing: ' iso_view_file], 'HorizontalAlignment', 'center');
        axis off;
    end

    % Standardize font for paper
    fontsize(fig, 10, 'points');
    
    % --- Save Section ---
    % exportgraphics(fig, [current_trial, '_Combined.png'], 'Resolution', 300);
end