function [val,n_star] = ConfidenceTesting(modelPerformance,type,crit)
    
    if nargin<3
        crit=0.165/3;
    end
    
    if matches(type,'Ideal')
        col='Test';
        val = modelPerformance.(col).MAE;
    elseif matches(type,'Actual')
        col='CV';
        val = modelPerformance.(col).MAE;
    elseif matches(type,'V2')
        col='MaxCIWidth';
        val = modelPerformance.(col);
    end

    resultIG = val < crit;
    row=find(resultIG,1,"first");
    
    if isempty(row) || (row+2)>max(size(val))
        n_star=NaN;
    else
        while (val(row) >= crit) || (val(row+1) >= crit) || (val(row+2) >= crit)
            val(row)=0;
            row=row+1;
        end
    row=row+2;
    n_star = modelPerformance.n(row);
    end
end