% [gifImage, cmap] = imread(strcat(fname,'.gif'), 'Frames', 'all');
% gifsize=size(gifImage);
% hi=implay(gifImage);
% hi.Visual.ColorMap.Map=cmap;
% hi.Parent.Position=[0,0,gifsize(2),gifsize(1)];